{
	"name": "syw-react",
	"version": "0.0.37",
	"description": "",
	"author": "Show Your Work Lab",
	"license": "MIT",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.es.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.es.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist/",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite dev",
		"prebuild": "npm --prefix ../common run trustlists",
		"build": "npm run build:lib && npm run build:demo",
		"build:lib": "vite build && tsc -p tsconfig.build.json",
		"build:demo": "vite build --config vite.demo.config.js",
		"build:release": "rushx build",
		"typecheck": "tsc --noEmit",
		"serve": "vite preview --port 8080",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d ./public",
		"release": "npm publish"
	},
	"dependencies": {
		"@ark-ui/react": "^5.36.2",
		"@contentauth/c2pa-types": "^0.7.5",
		"@contentauth/c2pa-web": "0.15.3",
		"lucide-react": "^1.14.0",
		"maplibre-gl": "^5.18.0",
		"syw-common": "^0.0.37"
	},
	"devDependencies": {
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^1.1.0",
		"baseline-browser-mapping": "^2.9.19",
		"gh-pages": "^6.1.1",
		"postcss": "~8.4.12",
		"postcss-nesting": "^10.0.2",
		"sass": "^1.89.2",
		"typescript": "^5.9.3",
		"vite": "^6.3.5"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	}
}
