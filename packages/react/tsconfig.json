{
	"compilerOptions": {
		"customConditions": ["syw-common-source"],
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"types": ["vite/client"],
		"paths": {
			"$src/*": ["./src/*"]
		}
	},
	"include": ["src", "demo"]
}
